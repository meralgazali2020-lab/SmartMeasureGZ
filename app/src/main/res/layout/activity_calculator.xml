<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="حاسبة المقاسات"
            android:textColor="#0B2341"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="تصميم المهندس حسين الغزالي"
            android:textColor="#B8860B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="معلومات المشروع"
            android:textColor="#0B2341"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/projectNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="اسم المشروع"
            android:inputType="text"
            android:padding="14dp" />

        <EditText
            android:id="@+id/customerNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="اسم الزبون - اختياري"
            android:inputType="text"
            android:padding="14dp" />

        <EditText
            android:id="@+id/projectNotesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="ملاحظات المشروع"
            android:inputType="textMultiLine"
            android:minHeight="80dp"
            android:padding="14dp" />

        <TextView
            android:id="@+id/currentOperationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="العملية ١"
            android:textColor="#B8860B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/lengthInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="الطول"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            android:padding="14dp" />

        <EditText
            android:id="@+id/widthInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="العرض"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            android:padding="14dp" />

        <EditText
            android:id="@+id/quantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="العدد"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:padding="14dp" />

        <Spinner
            android:id="@+id/unitSpinner"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/calculateBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:text="حساب"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="المقاس الأصلي للعملية الحالية"
            android:textColor="#0B2341"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:stretchColumns="*">

            <TableRow>

                <TextView
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="المقاس"
                    android:textStyle="bold" />

                <TextView
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="العدد"
                    android:textStyle="bold" />

                <TextView
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="المساحة"
                    android:textStyle="bold" />

            </TableRow>

            <TableRow>

                <TextView
                    android:id="@+id/originalMeasurementText"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="-" />

                <TextView
                    android:id="@+id/originalQuantityText"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="-" />

                <TextView
                    android:id="@+id/originalAreaText"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="-" />

            </TableRow>

        </TableLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="تعديل المقاسات"
            android:textColor="#0B2341"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/subtractRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="تنقيص" />

            <RadioButton
                android:id="@+id/addRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="زيادة" />

        </RadioGroup>

        <EditText
            android:id="@+id/lengthAdjustmentInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="قيمة تعديل الطول"
            android:inputType="numberDecimal"
            android:padding="14dp" />

        <EditText
            android:id="@+id/widthAdjustmentInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="قيمة تعديل العرض"
            android:inputType="numberDecimal"
            android:padding="14dp" />

        <Button
            android:id="@+id/applyAdjustmentBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:text="تطبيق التعديل"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="المقاس بعد التعديل"
            android:textColor="#0B2341"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:stretchColumns="*">

            <TableRow>

                <TextView
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="المقاس"
                    android:textStyle="bold" />

                <TextView
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="العدد"
                    android:textStyle="bold" />

                <TextView
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="المساحة"
                    android:textStyle="bold" />

            </TableRow>

            <TableRow>

                <TextView
                    android:id="@+id/adjustedMeasurementText"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="-" />

                <TextView
                    android:id="@+id/adjustedQuantityText"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="-" />

                <TextView
                    android:id="@+id/adjustedAreaText"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="-" />

            </TableRow>

        </TableLayout>

        <Button
            android:id="@+id/addOperationBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:text="إضافة العملية إلى المشروع"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/repeatLastOperationBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:text="تكرار العملية السابقة"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="العمليات المضافة"
            android:textColor="#0B2341"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/operationsCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="عدد العمليات: ٠"
            android:textColor="#666666"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/operationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/saveProjectBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:text="حفظ المشروع"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/savedProjectsBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="المشاريع المحفوظة"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/newProjectBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="مشروع جديد"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="25dp"
            android:text="مسح حقول العملية الحالية"
            android:textAllCaps="false"
            android:textSize="17sp" />

    </LinearLayout>

</ScrollView>

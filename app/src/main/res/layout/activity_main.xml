<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Smart Measure GZ"
            android:textColor="#0B2341"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="حاسبة المقاسات الذكية"
            android:textColor="#555555"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:text="تصميم المهندس حسين الغزالي"
            android:textColor="#B8860B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/newProjectBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="مشروع جديد"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <Button
            android:id="@+id/calculatorBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="حاسبة المقاسات"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <Button
            android:id="@+id/scanMeasurementsBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="تصوير وقراءة ورقة المقاسات"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <Button
            android:id="@+id/savedProjectsBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="المشاريع والمقاسات المحفوظة"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <Button
            android:id="@+id/notesBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="25dp"
            android:text="الملاحظات والكتابة"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="قياس • حساب • حفظ • تصوير"
            android:textColor="#777777"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
